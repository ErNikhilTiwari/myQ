# Application Environment
NODE_ENV=development
PORT=4000
WEB_URL=http://localhost:3000

# Database
# In dev, PostgreSQL via Docker or local instance
DATABASE_URL="postgresql://queueapp:queueapp_dev_password@localhost:5432/queueapp_dev?schema=public"

# Redis
REDIS_URL="redis://localhost:6379"

# JWT Authentication
JWT_ACCESS_SECRET="dev_access_secret_super_secure_random_key_change_in_prod"
JWT_REFRESH_SECRET="dev_refresh_secret_super_secure_random_key_change_in_prod"
JWT_ACCESS_EXPIRY="15m"
JWT_REFRESH_EXPIRY="7d"

# OTP Configuration
OTP_EXPIRY_MINUTES=5
OTP_MAX_ATTEMPTS=5
OTP_PROVIDER=mock # options: mock, msg91

# SMS / MSG91 (Production)
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=

# Storage (Cloudflare R2 / S3)
STORAGE_ENDPOINT=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_BUCKET=
STORAGE_PUBLIC_URL=

# Razorpay Payments (M9)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# WhatsApp Cloud API (M10)
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
