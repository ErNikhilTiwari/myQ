# Application Environment
NODE_ENV=development
PORT=4000
WEB_URL=http://localhost:3000

# Database
# In dev, PostgreSQL via Docker or local instance
DATABASE_URL="postgresql://queueapp:queueapp_dev_password@localhost:5432/queueapp_dev?schema=public"

# Redis
REDIS_URL="redis://localhost:6379"

# JWT Authentication
JWT_ACCESS_SECRET="dev_access_secret_super_secure_random_key_change_in_prod"
JWT_REFRESH_SECRET="dev_refresh_secret_super_secure_random_key_change_in_prod"
JWT_ACCESS_EXPIRY="15m"
JWT_REFRESH_EXPIRY="7d"

# OTP Configuration
OTP_EXPIRY_MINUTES=5
OTP_MAX_ATTEMPTS=5
OTP_PROVIDER=mock # options: mock, msg91

# SMS / MSG91 (Production)
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=

# Storage (Cloudflare R2 / S3)
STORAGE_ENDPOINT=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_BUCKET=
STORAGE_PUBLIC_URL=

# Razorpay Payments
# 1. Sign up at https://dashboard.razorpay.com/
# 2. Go to Settings -> API Keys to generate Key ID & Secret
# 3. Add Webhook URL: https://<your-domain>/api/webhooks/razorpay
#    Subscribe to: payment.captured, order.paid, payment.failed
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# WhatsApp Integration
# Option A: Official Meta WhatsApp Cloud API (https://developers.facebook.com/)
# 1. Create a Meta Developer App (Business Type) -> Add WhatsApp product
# 2. Get Phone Number ID from WhatsApp -> API Setup
# 3. Generate a Permanent System User Access Token in Business Manager
# 4. Set Webhook: https://<your-domain>/api/webhooks/whatsapp
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
META_APP_SECRET=

# Option B: Optional Third-Party WhatsApp Web API Gateway (e.g. Baileys / WPPConnect / Evolution API)
# If provided, outgoing WhatsApp messages will POST to this endpoint
WHATSAPP_GATEWAY_URL=

# SMS / OTP Delivery (MSG91 / Indian DLT)
# In India, TRAI mandates DLT registration for transactional SMS.
# Once registered, create an OTP template in MSG91 and enter credentials:
OTP_PROVIDER=mock # set to 'msg91' or 'sms' in production
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=
