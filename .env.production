# ==============================================================================
# Production Environment Configuration Template
# Populate these variables with your cloud production secrets.
# ==============================================================================

# Node Environment
NODE_ENV=production
PORT=4000
WEB_URL=https://your-domain.com

# ------------------------------------------------------------------------------
# 1. Managed PostgreSQL Connection
# Replace with AWS RDS, Supabase, Neon, or internal docker-compose postgres
# ------------------------------------------------------------------------------
DATABASE_URL="postgresql://queueapp:YOUR_SECURE_POSTGRES_PASSWORD@postgres:5432/queueapp_prod?schema=public&sslmode=prefer"

# ------------------------------------------------------------------------------
# 2. Redis In-Memory Cache & PubSub
# Replace with Upstash, AWS ElastiCache, or internal docker-compose redis
# ------------------------------------------------------------------------------
REDIS_URL="redis://redis:6379"

# ------------------------------------------------------------------------------
# 3. JWT Secret Keys (Generate with `openssl rand -base64 48`)
# ------------------------------------------------------------------------------
JWT_ACCESS_SECRET="GENERATE_A_LONG_RANDOM_SECRET_KEY_FOR_JWT_ACCESS"
JWT_REFRESH_SECRET="GENERATE_A_LONG_RANDOM_SECRET_KEY_FOR_JWT_REFRESH"
JWT_ACCESS_EXPIRY="15m"
JWT_REFRESH_EXPIRY="7d"

# ------------------------------------------------------------------------------
# 4. OTP Provider Configuration
# Set OTP_PROVIDER=msg91 for live Indian SMS delivery, or mock for demo
# ------------------------------------------------------------------------------
OTP_PROVIDER=msg91
OTP_EXPIRY_MINUTES=5
OTP_MAX_ATTEMPTS=5
MSG91_AUTH_KEY="YOUR_MSG91_AUTH_KEY"
MSG91_TEMPLATE_ID="YOUR_MSG91_TEMPLATE_ID"

# ------------------------------------------------------------------------------
# 5. Meta WhatsApp Business Cloud API (Official)
# Obtained from Meta for Developers -> WhatsApp -> API Setup
# ------------------------------------------------------------------------------
WHATSAPP_PHONE_NUMBER_ID="YOUR_META_PHONE_NUMBER_ID"
WHATSAPP_ACCESS_TOKEN="YOUR_META_SYSTEM_USER_PERMANENT_TOKEN"
WHATSAPP_WEBHOOK_VERIFY_TOKEN="YOUR_CUSTOM_WEBHOOK_VERIFY_TOKEN"
META_APP_SECRET="YOUR_META_APP_SECRET_FOR_HMAC_VERIFICATION"

# ------------------------------------------------------------------------------
# 6. Payment Gateways (Razorpay / Cashfree / PhonePe)
# ------------------------------------------------------------------------------
RAZORPAY_KEY_ID="rzp_live_YOUR_KEY_ID"
RAZORPAY_KEY_SECRET="YOUR_RAZORPAY_SECRET"
RAZORPAY_WEBHOOK_SECRET="YOUR_RAZORPAY_WEBHOOK_SECRET"

CASHFREE_APP_ID=""
CASHFREE_SECRET_KEY=""

PHONEPE_MERCHANT_ID=""
PHONEPE_SALT_KEY=""

# ------------------------------------------------------------------------------
# 7. Web Push Notification Keys (VAPID)
# Generate with `npx web-push generate-vapid-keys`
# ------------------------------------------------------------------------------
VAPID_PUBLIC_KEY="YOUR_GENERATED_VAPID_PUBLIC_KEY"
VAPID_PRIVATE_KEY="YOUR_GENERATED_VAPID_PRIVATE_KEY"
VAPID_SUBJECT="mailto:support@your-domain.com"

# ------------------------------------------------------------------------------
# 8. S3 / Cloudflare R2 Object Storage (For Clinic Logos & TV Ads)
# ------------------------------------------------------------------------------
STORAGE_ENDPOINT=""
STORAGE_ACCESS_KEY=""
STORAGE_SECRET_KEY=""
STORAGE_BUCKET="queueapp-production"
STORAGE_PUBLIC_URL="https://cdn.your-domain.com"
