{
  "name": "queue-app-monorepo",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces",
    "test": "npm run test --workspaces",
    "lint": "npm run lint --workspaces",
    "typecheck": "npm run typecheck --workspaces",
    "dev": "npm run dev --workspaces",
    "host": "npm run build --workspace=@queueapp/web && npm run build --workspace=@queueapp/api && node apps/api/dist/src/main.js",
    "host:quick": "node apps/api/dist/src/main.js",
    "db:push": "npm.cmd --prefix apps/api run db:push",
    "db:generate": "npm.cmd --prefix apps/api run db:generate"
  },
  "devDependencies": {
    "@types/node": "^20.11.24",
    "playwright-core": "^1.64.1",
    "typescript": "^5.3.3"
  }
}
